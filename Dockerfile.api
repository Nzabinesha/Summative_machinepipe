FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app TF_CPP_MIN_LOG_LEVEL=2 OMP_NUM_THREADS=1 TF_ENABLE_ONEDNN_OPTS=0
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY src ./src
COPY app ./app
COPY models ./models
COPY data ./data
EXPOSE 8000
CMD uvicorn app.api:app --host 0.0.0.0 --port ${PORT:-8000}
